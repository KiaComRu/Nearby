<IfModule mod_headers.c>
<FilesMatch "^(?:sw\.js|manifest(?:-(?:en|hi|zh-CN|es))?\.webmanifest|pwa\.js|pwa\.css)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<FilesMatch "^(?:config\.private\.php|\.user\.ini|.*\.(?:test|log|json))$">
Require all denied
</FilesMatch>
