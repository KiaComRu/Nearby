{
  "name": "nearby-transfer",
  "version": "0.6.8",
  "private": true,
  "description": "Nearby — передача файлов по локальной сети и через интернет",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "build:windows": "powershell -NoProfile -File desktop/windows/build.ps1",
    "build:web": "node browser/build.mjs",
    "build:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "test:pwa": "node scripts/pwa-e2e.mjs",
    "test:usage": "node scripts/usage-e2e.mjs",
    "test:shell": "node scripts/shell-e2e.mjs",
    "test:shell:native": "node scripts/shell-native-smoke.mjs",
    "test:downloads": "node scripts/download-choice-e2e.mjs",
    "build:icons": "node scripts/generate-favicons.mjs",
    "test:web": "node --test test/browser-*.test.mjs",
    "test:browser": "node scripts/browser-e2e.mjs",
    "test:internet": "node scripts/internet-e2e.mjs",
    "test:web:i18n": "node scripts/web-i18n-e2e.mjs",
    "test:discovery": "node scripts/discovery-e2e.mjs",
    "test:trusted": "node scripts/trusted-e2e.mjs",
    "test:pc": "node scripts/pc-e2e.mjs",
    "test:desktop:parity": "node scripts/desktop-parity-e2e.mjs",
    "test:desktop:native": "node scripts/desktop-parity-native-e2e.mjs",
    "test:desktop:internet": "node scripts/desktop-internet-e2e.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "playwright": "1.62.1"
  }
}
